(use-package emacs
  :ensure nil
  :init
  ;; Cria os diretórios se não existirem
  (let ((backup-dir (expand-file-name "emacs/backups/" "~/.cache"))
        (auto-save-dir (expand-file-name "emacs/auto-save/" "~/.cache")))
    (make-directory backup-dir t)
    (make-directory auto-save-dir t)
    (setq backup-directory-alist `(("." . ,backup-dir))
          auto-save-file-name-transforms `((".*" ,auto-save-dir t))))
  :custom
  (create-lockfiles nil)       ; desativa os .#arquivo
  (backup-by-copying t)        ; copia em vez de renomear
  (version-control t)          ; backups numerados
  (kept-new-versions 5)
  (kept-old-versions 2)
  (delete-old-versions t))

(which-key-mode t)
(which-key-setup-side-window-right)

(defun debmx-new-buffer ()
  "Cria um novo buffer `sem nome`"
  (interactive) ;; funções disponiveis no emacs ou um comando personalizavel
  (let ((debmx/buf (generate-new-buffer "sem nome")))
    (switch-to-buffer debmx/buf)
    (funcall initial-major-mode)
    (setq buffer-offer-save t)
    debmx/buf))

